    <worksheet name='Tranasaction Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Financial Metric Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customer_Financial_Profiles_Cleaned' name='federated.0uxdwl90nx9jas11yaoha1w3d1qy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Financial Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Transaction Amount&quot;'>
              <calculation class='tableau' formula='&quot;Transaction Amount&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uxdwl90nx9jas11yaoha1w3d1qy'>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Selected Financial Metric' datatype='real' name='[Calculation_2037989836161026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Transaction Amount&quot;&#13;&#10;THEN SUM([Amount])&#13;&#10;&#13;&#10;WHEN &quot;Total Debt&quot;&#13;&#10;THEN SUM([TotalDebt])&#13;&#10;&#13;&#10;WHEN &quot;Yearly Income&quot;&#13;&#10;THEN SUM([YearlyIncome])&#13;&#10;&#13;&#10;WHEN &quot;Credit Score&quot;&#13;&#10;THEN AVG([CreditScore])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Credit Score' datatype='integer' name='[CreditScore]' role='measure' type='quantitative' />
            <column caption='Total Debt' datatype='integer' name='[TotalDebt]' role='measure' type='quantitative' />
            <column caption='Transaction Year' datatype='integer' name='[TransactionYear]' role='dimension' type='quantitative' />
            <column caption='Yearly Income' datatype='integer' name='[YearlyIncome]' role='measure' type='quantitative' />
            <column-instance column='[TransactionYear]' derivation='None' name='[none:TransactionYear:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2037989836161026]' derivation='User' name='[usr:Calculation_2037989836161026:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[Parameters].[Parameter 1]' />
            </encodings>
            <style>
              <style-rule element='pane'>
                <format attr='minwidth' value='597' />
                <format attr='maxwidth' value='597' />
                <format attr='minheight' value='360' />
                <format attr='maxheight' value='360' />
                <format attr='aspect' value='0' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.0uxdwl90nx9jas11yaoha1w3d1qy].[usr:Calculation_2037989836161026:qk]</rows>
        <cols>[federated.0uxdwl90nx9jas11yaoha1w3d1qy].[none:TransactionYear:qk]</cols>
      </table>
